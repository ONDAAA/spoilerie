{
  "manifest_version": 3,
  "name": "Spoilerie",
  "version": "0.1.0",
  "description": "Hides YouTube comments that spoil content you haven't watched yet.",
  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "http://localhost:8000/*",
    "https://spoilerie-api.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/watch*"],
      "js": ["transcript-extractor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Spoilerie"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
